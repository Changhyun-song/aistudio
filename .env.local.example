# OPENAI_MODEL_PLANNER=gpt-5.4-mini     # 플래너용
# OPENAI_MODEL_OPTIMIZER=gpt-5.4-mini   # 프롬프트 최적화용
# 최고 품질이 필요하면 gpt-5.4 (비용 3x)
# 비용 절약이 필요하면 gpt-5.4-nano (품질 하락 있음)

